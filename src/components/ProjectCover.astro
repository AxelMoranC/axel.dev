---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import { editorTheme } from '../styles/editor-theme';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const { project, class: className, loading = 'lazy', sizes = '(min-width: 1024px) 50vw, 100vw' } = Astro.props;
const { cover, coverAlt, coverFit, coverSnippet } = project.data;
const contain = coverFit === 'contain';
---

{
  coverSnippet ? (
    <div class:list={['img-frame snippet-cover', className]} transition:name={`cover-${project.id}`}>
      <div class="snippet-chrome" aria-hidden="true">
        <span class="snippet-dots">
          <span />
          <span />
          <span />
        </span>
        <span class="snippet-tab font-mono">{coverSnippet.filename}</span>
      </div>
      <div class="snippet-body font-mono">
        <Code
          code={coverSnippet.code}
          lang={coverSnippet.lang as 'ts'}
          themes={{ light: editorTheme, dark: editorTheme }}
          tabindex="-1"
        />
      </div>
    </div>
  ) : (
    cover && (
      <div
        class:list={['img-frame', contain && 'cover-contain grid place-items-center p-6 sm:p-10', className]}
        transition:name={`cover-${project.id}`}
      >
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          loading={loading}
          fetchpriority={loading === 'eager' ? 'high' : undefined}
          widths={contain ? [cover.width, Math.min(cover.width * 2, 1600)] : [480, 800, 1200, 1600]}
          sizes={contain ? `${cover.width}px` : sizes}
          class:list={contain ? 'h-auto max-h-full w-full object-contain' : 'size-full object-cover'}
          style={contain ? `max-width: ${cover.width}px` : undefined}
        />
      </div>
    )
  )
}

<style>
  /* Screenshots keep their native size on a panel instead of being cropped,
     because UI text becomes unreadable when object-cover scales it. */
  .cover-contain :global(img) {
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgb(43 38 32 / 0.06),
      0 12px 32px -16px rgb(43 38 32 / 0.28);
  }

  .snippet-cover {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #1d1915;
    outline-color: #3b332a;
  }
  :global([data-theme='dark']) .snippet-cover {
    background: #12100d;
  }
  .snippet-chrome {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #3b332a;
  }
  .snippet-dots {
    display: flex;
    gap: 0.375rem;
  }
  .snippet-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #6c5e4c;
  }
  .snippet-tab {
    font-size: 12px;
    color: #ece6dc;
  }
  .snippet-body {
    flex: 1;
    min-height: 0;
    padding: 1.1rem 1.25rem;
    overflow: hidden;
    /* Long snippets fade out instead of ending on a hard, half-cut line. */
    mask-image: linear-gradient(to bottom, black 78%, transparent);
  }
  .snippet-body :global(pre.astro-code) {
    margin: 0;
    background: transparent !important;
    font-size: 12px;
    line-height: 1.7;
    white-space: pre;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .snippet-body :global(pre.astro-code) {
      font-size: 13px;
    }
  }
</style>
