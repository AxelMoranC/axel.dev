---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'large' | 'default';
  index?: number;
  class?: string;
  headingLevel?: 2 | 3;
}

const { project, size = 'default', index = 0, class: className, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const { title, summary, year, stack } = project.data;
const large = size === 'large';
---

<a
  href={`/projects/${project.id}`}
  class:list={['group flex min-w-0 flex-col', className]}
  data-reveal
  style={`--i:${index}`}
>
  <ProjectCover
    project={project}
    loading={index < 2 ? 'eager' : 'lazy'}
    sizes={large ? '(min-width: 1024px) 640px, 100vw' : '(min-width: 1024px) 460px, (min-width: 768px) 50vw, 100vw'}
    class={large ? 'aspect-[4/3] md:aspect-auto md:min-h-[22rem] md:flex-1' : 'aspect-[16/10]'}
  />
  <div class="mt-4 flex items-baseline justify-between gap-4">
    <Heading class:list={['font-semibold tracking-tight', large ? 'text-xl md:text-2xl' : 'text-lg']}>
      <span class="link-underline">{title}</span>
    </Heading>
    <span class="shrink-0 font-mono text-xs text-muted">{year}</span>
  </div>
  <p class="mt-1.5 max-w-[56ch] text-[0.95rem] text-muted">{summary}</p>
  <p class="mt-3 font-mono text-xs text-muted">{stack.join(', ')}</p>
</a>
