---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-30 border-b border-line/70 bg-bg/80 backdrop-blur-md"
  transition:animate="none"
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="text-[0.95rem] font-semibold tracking-tight" aria-label={`${site.name}, home`}>
      {site.name}
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Primary" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => {
              const active = isActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'relative block rounded-full px-3 py-1.5 text-sm transition-colors duration-200',
                      active ? 'text-ink' : 'text-muted hover:text-ink',
                    ]}
                  >
                    {item.label}
                    {active && (
                      <span
                        class="absolute inset-x-3 -bottom-px h-px bg-accent"
                        style="view-transition-name: nav-indicator"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <ThemeToggle />

      <button
        type="button"
        class="grid size-9 place-items-center rounded-full text-ink transition-colors hover:bg-surface sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-button
      >
        <Icon name="ph:list" class="size-5" data-icon-open />
        <Icon name="ph:x" class="hidden size-5" data-icon-close />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-line/70 sm:hidden" data-menu>
    <ul class="container-page flex flex-col py-3">
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block py-3 text-2xl font-medium tracking-tight',
                isActive(item.href) ? 'text-ink' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-menu].is-open .menu-item {
      animation: menu-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 50ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>

<script>
  function initMenu() {
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!button || !menu) return;

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('is-open', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        button.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
