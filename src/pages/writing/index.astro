---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = Object.entries(
  posts.reduce<Record<string, typeof posts>>((acc, post) => {
    const year = String(post.data.date.getUTCFullYear());
    (acc[year] ??= []).push(post);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="Writing" description="Notes on engineering, building products and things I am learning.">
  <PageHeader title="Writing" intro="Placeholder. A sentence on what you write about and how often." />

  <section class="container-page">
    {
      posts.length === 0 ? (
        <p class="text-muted">No posts yet. The first one is on its way.</p>
      ) : (
        byYear.map(([year, items]) => (
          <div class="grid gap-4 border-t border-line py-10 md:grid-cols-12 md:gap-6" data-reveal>
            <h2 class="font-mono text-sm text-muted md:col-span-2">{year}</h2>
            <ul class="flex flex-col gap-2 md:col-span-10">
              {items.map((post) => (
                <li>
                  <a
                    href={`/writing/${post.id}`}
                    class="group -mx-4 flex flex-col gap-1 rounded-2xl px-4 py-4 transition-colors duration-300 hover:bg-surface sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                  >
                    <span>
                      <span class="block text-lg font-medium tracking-tight">{post.data.title}</span>
                      <span class="mt-1 block max-w-[60ch] text-muted">{post.data.description}</span>
                    </span>
                    <span class="shrink-0 font-mono text-xs text-muted">
                      <FormattedDate date={post.data.date} format="short" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      )
    }
  </section>
</BaseLayout>
