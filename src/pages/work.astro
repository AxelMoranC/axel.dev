---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ResumeLink from '../components/ResumeLink.astro';
import { education, resume, site, skills } from '../config';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description={`Experience, education and skills of ${site.name}.`}>
  <PageHeader title="Work" intro="Software engineer at Shopify, after internships across commerce platforms, consumer apps, internal tools and QA automation.">
    {
      resume.url && (
        <div class="mt-8" data-reveal style="--i:2">
          <ResumeLink />
        </div>
      )
    }
  </PageHeader>

  <section class="container-page" aria-label="Experience">
    <ol>
      {
        experience.map((job) => (
          <li class="grid gap-4 border-t border-line py-10 md:grid-cols-12 md:gap-6 md:py-14" data-reveal>
            <div class="md:col-span-4">
              <p class="font-mono text-xs text-muted">
                {job.data.start} - {job.data.end}
              </p>
              <h2 class="mt-2 text-xl font-semibold tracking-tight">
                {job.data.url ? (
                  <a href={job.data.url} target="_blank" rel="noopener noreferrer" class="link-underline">
                    {job.data.company}
                  </a>
                ) : (
                  job.data.company
                )}
              </h2>
              <p class="text-muted">{job.data.role}</p>
            </div>
            <div class="md:col-span-8">
              <p class="max-w-[62ch] text-[1.05rem]">{job.data.summary}</p>
              {job.data.highlights.length > 0 && (
                <ul class="mt-5 flex max-w-[62ch] flex-col gap-2.5 text-muted">
                  {job.data.highlights.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.7em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
              {job.data.links.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                  {job.data.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-accent-ink">
                        <span class="link-underline">{link.label}</span>
                        <Icon name="ph:arrow-up-right" class="size-3.5" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {job.data.stack.length > 0 && <p class="mt-5 font-mono text-xs text-muted">{job.data.stack.join(', ')}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-16 md:mt-24" aria-labelledby="education-heading">
    <div class="grid gap-6 rounded-[14px] bg-surface p-6 md:grid-cols-12 md:p-10" data-reveal>
      <h2 id="education-heading" class="text-2xl font-semibold tracking-[-0.025em] md:col-span-4">Education</h2>
      <div class="flex flex-col gap-6 md:col-span-8">
        {
          education.map((item) => (
            <div>
              <p class="font-mono text-xs text-muted">{item.years}</p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight">{item.school}</h3>
              <p class="text-muted">{item.degree}</p>
              {item.note && <p class="mt-3 max-w-[60ch] text-muted">{item.note}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page mt-16 md:mt-24" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="text-2xl font-semibold tracking-[-0.025em] md:text-3xl" data-reveal>Skills</h2>
    <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((group, i) => (
          <div data-reveal style={`--i:${i}`}>
            <h3 class="font-mono text-xs text-muted">{group.group}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-line px-3 py-1 text-sm">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
