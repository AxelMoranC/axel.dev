---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeLink from '../components/ResumeLink.astro';
import { about, site } from '../config';
---

<BaseLayout title="About" description={`About ${site.name}.`}>
  <section class="container-page pt-10 md:pt-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <div class="md:sticky md:top-28">
          <div class="img-frame aspect-[4/5]" transition:name="portrait">
            <Image
              src={site.portrait.src}
              alt={site.portrait.alt}
              widths={[400, 640, 960]}
              sizes="(min-width: 768px) 440px, 100vw"
              loading="eager"
              fetchpriority="high"
              class="size-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <h1 class="text-4xl font-semibold tracking-[-0.035em] md:text-6xl md:leading-[1.02]" data-reveal-load>About</h1>

        <div class="prose mt-8" data-reveal-load style="--i:1">
          <p>
            I'm a full-time Software Engineer I at Shopify, based in Montreal. I studied Computer Science at Concordia University,
            class of 2026.
          </p>
          <p>
            Before joining full time, I interned at Shopify, BetterSleep, Actalent and VuWall Technology. As a Shopify intern I built the{' '}
            <a href="https://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings#article_list"
              ><code>article_list</code> theme setting</a
            >, and at BetterSleep I worked on React features for an app with more than 3 million monthly active users.
            Before that I built internal tools and automated end-to-end tests.
          </p>
          <p>I speak English, French and Spanish.</p>
          {about.personal && <p>{about.personal}</p>}
        </div>

        {
          about.now && (
            <div class="mt-14 border-t border-line pt-8" data-reveal>
              <h2 class="text-xl font-semibold tracking-tight">Now</h2>
              <p class="mt-3 max-w-[60ch] text-muted">{about.now}</p>
            </div>
          )
        }

        {
          about.outside && (
            <div class="mt-10 border-t border-line pt-8" data-reveal>
              <h2 class="text-xl font-semibold tracking-tight">Outside of work</h2>
              <p class="mt-3 max-w-[60ch] text-muted">{about.outside}</p>
            </div>
          )
        }

        <div class="mt-12 flex flex-wrap gap-3" data-reveal>
          <a
            href="#contact"
            class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-transform duration-200 active:scale-[0.98]"
          >
            Get in touch
          </a>
          <ResumeLink />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
