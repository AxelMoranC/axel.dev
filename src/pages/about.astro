---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout title="About" description={`About ${site.name}.`}>
  <section class="container-page pt-10 md:pt-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <div class="md:sticky md:top-28">
          <div class="img-frame aspect-[4/5]" transition:name="portrait">
            <img src={site.portrait.src} alt={site.portrait.alt} width="960" height="1200" loading="eager" class="size-full object-cover" />
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <h1 class="text-4xl font-semibold tracking-[-0.035em] md:text-6xl md:leading-[1.02]" data-reveal>About</h1>

        <div class="prose mt-8" data-reveal style="--i:1">
          <p>
            Placeholder bio, paragraph one. Who you are, what you do today, and the kind of problems you enjoy working
            on. Keep it in your own voice.
          </p>
          <p>
            Placeholder bio, paragraph two. How you got into software, what shaped how you work, and what you are
            getting better at right now.
          </p>
        </div>

        <div class="mt-14 border-t border-line pt-8" data-reveal>
          <h2 class="text-xl font-semibold tracking-tight">Now</h2>
          <p class="mt-3 max-w-[60ch] text-muted">
            Placeholder. What you are focused on this season: work, a side project, something you are learning.
          </p>
        </div>

        <div class="mt-10 border-t border-line pt-8" data-reveal>
          <h2 class="text-xl font-semibold tracking-tight">Outside of work</h2>
          <p class="mt-3 max-w-[60ch] text-muted">
            Placeholder. Hobbies, interests, or anything that gives people a reason to start a conversation.
          </p>
        </div>

        <div class="mt-12 flex flex-wrap gap-3" data-reveal>
          <a
            href="#contact"
            class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-transform duration-200 active:scale-[0.98]"
          >
            Get in touch
          </a>
          {
            site.resumeUrl && (
              <a
                href={site.resumeUrl}
                class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:bg-accent-soft"
              >
                <Icon name="ph:file-arrow-down" class="size-4" />
                Download resume
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
