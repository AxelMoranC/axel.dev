---
import { getProjects } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Selected projects, hackathon builds and experiments.">
  <PageHeader title="Projects" intro="Work projects, hackathon builds and things I made to learn something new." />
  <section class="container-page">
    <div class="grid gap-x-6 gap-y-14 md:grid-cols-2">
      {projects.map((project, i) => <ProjectCard project={project} index={i % 2} headingLevel={2} />)}
    </div>
  </section>
</BaseLayout>
